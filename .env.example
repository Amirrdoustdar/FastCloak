# ===========================================
# App Configuration
# ===========================================
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
DEBUG=true
APP_NAME=FastCloak
LOG_LEVEL=INFO

# ===========================================
# OAuth2 Provider (keycloak, google, github)
# ===========================================
OAUTH2_PROVIDER=keycloak

# ===========================================
# Keycloak Configuration
# ===========================================
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=my-realm
KEYCLOAK_CLIENT_ID=oauth2-proxy
KEYCLOAK_CLIENT_SECRET=xJrQ9vK3mP8nL2wY5tR6uE4sD7fG1hA0
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback
KEYCLOAK_VERIFY_SSL=false

# Keycloak Admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Access Control
REQUIRED_ROLES=app-user
REQUIRED_GROUPS=

# ===========================================
# Google OAuth2 (Optional)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ===========================================
# GitHub OAuth2 (Optional)
# ===========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# ===========================================
# JWT Configuration
# ===========================================
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Redis (Session Store)
# ===========================================
REDIS_URL=redis://localhost:6379
SESSION_EXPIRE_SECONDS=3600

# ===========================================
# Database
# ===========================================
DATABASE_URL=sqlite:///./oauth2_proxy.db

# ===========================================
# Upstream Service
# ===========================================
UPSTREAM_URL=http://localhost:9000

# ===========================================
# Access Control Lists
# ===========================================
ALLOWED_DOMAINS=
ALLOWED_EMAILS=

# ===========================================
# Cookie Configuration
# ===========================================
COOKIE_NAME=_oauth2_proxy
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true