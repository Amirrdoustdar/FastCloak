# app/config.py
from pydantic_settings import BaseSettings
from typing import List, Optional


class Settings(BaseSettings):
    # App
    APP_NAME: str = "OAuth2 Proxy"
    DEBUG: bool = False
    SECRET_KEY: str

    # OAuth2 Provider
    OAUTH2_PROVIDER: str = "keycloak"  # keycloak, google, github

    # ─────────────────────────────────────────
    # Keycloak Settings
    # ─────────────────────────────────────────
    KEYCLOAK_SERVER_URL: str = "http://localhost:8080"
    KEYCLOAK_REALM: str = "my-realm"
    KEYCLOAK_CLIENT_ID: str = "oauth2-proxy"
    KEYCLOAK_CLIENT_SECRET: str = ""
    KEYCLOAK_REDIRECT_URI: str = "http://localhost:8000/auth/callback"

    # Keycloak Admin (for user management)
    KEYCLOAK_ADMIN_USERNAME: str = "admin"
    KEYCLOAK_ADMIN_PASSWORD: str = "admin"

    # OIDC Discovery URL (auto-configured by Keycloak)
    # http://localhost:8080/realms/{realm}/.well-known/openid-configuration
    KEYCLOAK_VERIFY_SSL: bool = True

    # Roles & Groups
    REQUIRED_ROLES: List[str] = []         # e.g. ["app-user", "app-admin"]
    REQUIRED_GROUPS: List[str] = []        # e.g. ["/developers"]

    # ─────────────────────────────────────────
    # Google OAuth2
    # ─────────────────────────────────────────
    GOOGLE_CLIENT_ID: Optional[str] = None
    GOOGLE_CLIENT_SECRET: Optional[str] = None
    GOOGLE_REDIRECT_URI: str = "http://localhost:8000/auth/callback"

    # ─────────────────────────────────────────
    # GitHub OAuth2
    # ─────────────────────────────────────────
    GITHUB_CLIENT_ID: Optional[str] = None
    GITHUB_CLIENT_SECRET: Optional[str] = None
    GITHUB_REDIRECT_URI: str = "http://localhost:8000/auth/callback"

    # JWT
    JWT_ALGORITHM: str = "RS256"           # Keycloak uses RS256
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 30
    REFRESH_TOKEN_EXPIRE_DAYS: int = 7

    # Redis
    REDIS_URL: str = "redis://localhost:6379"
    SESSION_EXPIRE_SECONDS: int = 3600

    # Database
    DATABASE_URL: str = "sqlite:///./oauth2_proxy.db"

    # Upstream
    UPSTREAM_URL: str = "http://localhost:9000"

    # Access Control
    ALLOWED_DOMAINS: List[str] = []
    ALLOWED_EMAILS: List[str] = []

    # Cookie
    COOKIE_NAME: str = "_oauth2_proxy"
    COOKIE_SECURE: bool = False
    COOKIE_HTTPONLY: bool = True

    class Config:
        env_file = ".env"


settings = Settings()