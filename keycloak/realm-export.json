{
  "realm": "my-realm",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "oauth2-proxy",
      "name": "FastCloak",
      "enabled": true,
      "publicClient": false,
      "secret": "xJrQ9vK3mP8nL2wY5tR6uE4sD7fG1hA0",
      "redirectUris": [
        "http://localhost:8000/auth/callback",
        "http://localhost:8000/*"
      ],
      "webOrigins": ["http://localhost:8000"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {"name": "admin"},
      {"name": "manager"},
      {"name": "app-user"},
      {"name": "developer"}
    ]
  },
  "groups": [
    {"name": "admins", "path": "/admins"},
    {"name": "managers", "path": "/managers"},
    {"name": "developers", "path": "/developers"},
    {"name": "users", "path": "/users"}
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{
        "type": "password",
        "value": "admin123",
        "temporary": false
      }],
      "realmRoles": ["admin", "app-user"],
      "groups": ["/admins"]
    },
    {
      "username": "user",
      "email": "user@example.com",
      "firstName": "Regular",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{
        "type": "password",
        "value": "user123",
        "temporary": false
      }],
      "realmRoles": ["app-user"],
      "groups": ["/users"]
    }
  ]
}